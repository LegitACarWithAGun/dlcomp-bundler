{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-bundler",
			"type": "process",
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": true,
			},
			// replace with whatever generator youre using
			"command": "ninja",
			"args": [
				"-C",
				"./build"
			],
			"problemMatcher": "$gcc"
		},
		{
			"label": "build cmake (fresh)",
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": true
			},
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"command": "cmake",
			"args": [
				"..",
				"--fresh"
			],
			"problemMatcher": []
		}
	]
}